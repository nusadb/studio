import { SelectionStore } from "../stores.slint";
import { Theme, Metrics } from "../theme.slint";
import { Icon } from "../components/icon.slint";
import { StatusDot } from "../components/status_dot.slint";

// A dim pipe between status segments.
component Sep inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;

    Text {
        text: "·";
        color: Theme.gutter-fg;
        font-size: Metrics.text-sm;
    }
}

// Bottom strip: the context of whatever is focused — server, database, last result.
// A segment with nothing to say is left out rather than shown as a dash.
export component StatusBar inherits Rectangle {
    in property <string> status: "disconnected";
    in property <string> server;
    in property <string> database;
    in property <string> rows;
    in property <string> timing;
    in property <string> version;
    in property <string> txn: "idle";

    min-height: Metrics.statusbar-h;
    max-height: Metrics.statusbar-h;
    background: Theme.chrome;

    // `border-t border-border`. See the note in `inspector.slint`: without an explicit `y`
    // this hairline is centred vertically and lands in the middle of the bar.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: Metrics.s4;
        padding-right: Metrics.s4;
        spacing: Metrics.s3;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            StatusDot {
                status: root.status;
                diameter: 7px;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: root.server;
                color: Theme.muted-fg;
                font-size: Metrics.text-xs;
            }
        }

        if root.database != "": Sep { }

        if root.database != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Icon {
                name: "database";
                tint: Theme.muted-fg;
                size: 10px;
            }
        }

        if root.database != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: root.database;
                color: Theme.muted-fg;
                font-size: Metrics.text-xs;
            }
        }

        if root.rows != "": Sep { }

        if root.rows != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: root.rows;
                color: Theme.muted-fg;
                font-size: Metrics.text-xs;
            }
        }

        if root.timing != "": Sep { }

        if root.timing != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Icon {
                name: "clock";
                tint: Theme.muted-fg;
                size: 10px;
            }
        }

        if root.timing != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: root.timing;
                color: Theme.muted-fg;
                font-size: Metrics.text-xs;
            }
        }

        Rectangle { }

        if root.txn != "idle": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: root.txn == "failed" ? "Transaction failed" : "Transaction open";
                color: root.txn == "failed" ? Theme.destructive : Theme.warning;
                font-size: Metrics.text-xs;
                font-weight: 600;
            }
        }

        // Count, sum, average… of the cells selected in a grid.
        if SelectionStore.summary != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: SelectionStore.summary;
                color: Theme.foreground;
                font-size: Metrics.text-xs;
                font-family: Metrics.font-mono;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: root.version;
                color: Theme.muted-fg;
                font-size: Metrics.text-xs;
                opacity: 0.7;
            }
        }
    }
}
