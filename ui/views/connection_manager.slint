import { ScrollView } from "std-widgets.slint";
import { Theme, Metrics } from "../theme.slint";
import { ServerRow } from "../models.slint";
import { StatusDot } from "../components/status_dot.slint";
import { Badge, EnvBadge } from "../components/badge.slint";
import { AppButton } from "../components/app_button.slint";
import { FormField } from "../components/form_field.slint";
import { Toggle } from "../components/toggle.slint";

// A saved server, rendered as a card in the list on the left of this screen.
component ServerCard inherits Rectangle {
    in property <ServerRow> server;
    in property <bool> selected;
    // This card's Remove has been pressed once and is waiting for the second press.
    in property <bool> confirming;
    callback edit();
    callback remove();
    callback connect();
    callback disconnect();

    property <bool> live: root.server.status == "connected" || root.server.status == "connecting";

    height: 84px;
    border-radius: Metrics.radius;
    border-width: 1px;
    border-color: root.selected ? Theme.primary : Theme.border;
    background: card-touch.has-hover && !root.selected ? Theme.muted.with-alpha(0.5) : Theme.card;

    card-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.edit();
        }
    }

    HorizontalLayout {
        padding-left: Metrics.s3;
        padding-right: Metrics.s3;
        spacing: Metrics.s3;

        VerticalLayout {
            spacing: 3px;
            alignment: center;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: Metrics.s2;

                VerticalLayout {
                    alignment: center;

                    StatusDot {
                        status: root.server.status;
                    }
                }

                Text {
                    text: root.server.name;
                    color: Theme.foreground;
                    font-size: Metrics.text-md;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                VerticalLayout {
                    alignment: center;

                    EnvBadge {
                        env: root.server.env;
                    }
                }

                if root.server.tls: VerticalLayout {
                    alignment: center;

                    Badge {
                        label: "TLS";
                        tone: Theme.info;
                    }
                }

                Rectangle { }
            }

            Text {
                text: root.server.endpoint + "  ·  " + root.server.detail;
                color: Theme.muted-fg;
                font-size: Metrics.text-sm;
                font-family: Metrics.font-mono;
                overflow: elide;
            }

            Text {
                text: root.server.last-used;
                color: Theme.gutter-fg;
                font-size: Metrics.text-xs;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: Metrics.s1;

                AppButton {
                    label: root.live ? "Disconnect" : "Connect";
                    variant: root.live ? "outline" : "secondary";
                    size: "sm";
                    enabled: root.server.status != "connecting";
                    clicked => {
                        if (root.live) {
                            root.disconnect();
                        } else {
                            root.connect();
                        }
                    }
                }

                AppButton {
                    label: "Edit";
                    variant: "ghost";
                    size: "sm";
                    clicked => {
                        root.edit();
                    }
                }

                AppButton {
                    label: root.confirming ? "Really remove?" : "Remove";
                    variant: root.confirming ? "danger" : "ghost";
                    size: "sm";
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }
}

// One selectable environment tag in the form.
component EnvChip inherits Rectangle {
    in property <string> env;
    in property <bool> active;
    callback picked();

    property <color> tone: root.env == "prod" ? Theme.env-prod
        : root.env == "staging" ? Theme.env-staging
        : Theme.env-dev;

    height: 24px;
    border-radius: Metrics.radius-sm;
    border-width: 1px;
    border-color: root.active ? root.tone : Theme.border;
    background: root.active ? root.tone.with-alpha(0.16)
        : touch.has-hover ? Theme.muted
        : Colors.transparent;

    HorizontalLayout {
        alignment: center;
        padding-left: Metrics.s2;
        padding-right: Metrics.s2;

        Text {
            text: root.env;
            color: root.active ? root.tone : Theme.muted-fg;
            font-size: Metrics.text-sm;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.picked();
        }
    }
}

// Inline result of the last "Test Connection" attempt.
component ResultBanner inherits Rectangle {
    in property <string> state;
    in property <string> message;

    property <color> tone: root.state == "ok" ? Theme.success
        : root.state == "error" ? Theme.destructive
        : root.state == "testing" ? Theme.warning
        : Theme.info;

    // Height comes from the inner layout rather than from `text.preferred-height`: reading a
    // child's preferred size back into the parent's height is a binding loop.
    vertical-stretch: 0;
    border-radius: Metrics.radius;
    border-width: 1px;
    border-color: root.tone.with-alpha(0.4);
    background: root.tone.with-alpha(0.12);

    VerticalLayout {
        padding: Metrics.s2;

        Text {
            text: root.message;
            color: root.tone;
            font-size: Metrics.text-sm;
            wrap: word-wrap;
        }
    }
}

// Centre pane: the Connection Manager (screen 1 of the design brief) — saved servers on the
// left, the add/edit form on the right.
export component ConnectionManager inherits Rectangle {
    in property <[ServerRow]> servers;
    in property <int> selected-id: -1;
    in property <bool> editing: false;
    // The add / edit form is shown only while it is in use: after New server or Edit, or when
    // nothing is saved yet. Cancel and a successful save close it.
    in-out property <bool> form-open: false;
    property <bool> show-form: root.form-open || root.servers.length == 0;
    in property <string> test-state: "idle";
    in property <string> test-message;
    in property <string> form-error;

    in-out property <string> draft-name;
    in-out property <string> draft-host;
    in-out property <string> draft-port;
    in-out property <string> draft-user;
    in-out property <string> draft-password;
    in-out property <bool> draft-remember;
    in-out property <string> draft-database;
    in-out property <string> draft-env;
    in-out property <bool> draft-tls;
    in-out property <string> draft-ca-path;
    in-out property <string> draft-metrics;

    callback edit(int);
    callback remove(int);
    callback connect(int);
    callback disconnect(int);
    callback save();
    callback test();
    callback reset();
    // Raised whenever the user changes any field, so a stale test result can be retired.
    callback draft-changed();

    // The card whose Remove is armed; any other click disarms it.
    property <int> confirm-id: -1;

    background: Theme.background;
    min-width: 0px;
    min-height: 0px;
    clip: true;

    VerticalLayout {
        // ── Screen header ────────────────────────────────────────────────────
        Rectangle {
            min-height: 52px;
            max-height: 52px;
            vertical-stretch: 0;
            background: Theme.background;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: Metrics.s5;
                padding-right: Metrics.s5;
                spacing: Metrics.s3;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: "Servers";
                        color: Theme.foreground;
                        font-size: Metrics.text-lg;
                        font-weight: 600;
                    }

                    Text {
                        text: root.servers.length == 1 ? "1 saved server" : root.servers.length + " saved servers";
                        color: Theme.muted-fg;
                        font-size: Metrics.text-sm;
                    }
                }

                Rectangle { }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    AppButton {
                        label: "New server";
                        icon: "plus";
                        variant: root.show-form ? "outline" : "primary";
                        size: "sm";
                        clicked => {
                            root.confirm-id = -1;
                            root.reset();
                            root.form-open = true;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding: Metrics.s5;
            spacing: Metrics.s5;

            // ── Saved-server list ────────────────────────────────────────────
            VerticalLayout {
                spacing: Metrics.s3;

                if root.servers.length == 0: Rectangle {
                    border-radius: Metrics.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.card;

                    VerticalLayout {
                        alignment: center;
                        spacing: Metrics.s2;

                        Text {
                            text: "No servers saved yet";
                            color: Theme.foreground;
                            font-size: Metrics.text-md;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Fill in the form to add one. It starts out pointed at a\nlocal NusaDB on 127.0.0.1:5678.";
                            color: Theme.muted-fg;
                            font-size: Metrics.text-md;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.servers.length > 0: cards := ScrollView {
                    viewport-height: root.servers.length * 92px;

                    VerticalLayout {
                        width: cards.visible-width;
                        spacing: Metrics.s2;
                        alignment: start;

                        for server[index] in root.servers: ServerCard {
                            server: server;
                            selected: server.id == root.selected-id;
                            confirming: server.id == root.confirm-id;
                            edit => {
                                root.confirm-id = -1;
                                root.edit(server.id);
                                root.form-open = true;
                            }
                            remove => {
                                if (root.confirm-id == server.id) {
                                    root.confirm-id = -1;
                                    root.remove(server.id);
                                } else {
                                    root.confirm-id = server.id;
                                }
                            }
                            connect => {
                                root.confirm-id = -1;
                                root.connect(server.id);
                            }
                            disconnect => {
                                root.confirm-id = -1;
                                root.disconnect(server.id);
                            }
                        }
                    }
                }
            }

            // ── Add / edit form ──────────────────────────────────────────────
            // Scrolls: with TLS on and a message showing, the form is taller than a laptop
            // window, and the Save button must never end up below the edge.
            if root.show-form: Rectangle {
                min-width: 320px;
                max-width: 360px;
                horizontal-stretch: 0;
                border-radius: Metrics.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.card;
                clip: true;

                form-scroll := ScrollView {
                VerticalLayout {
                    width: form-scroll.visible-width;
                    padding: Metrics.s4;
                    spacing: Metrics.s3;
                    alignment: start;

                    HorizontalLayout {
                        Text {
                            text: root.editing ? "Edit server" : "New server";
                            horizontal-stretch: 1;
                            color: Theme.foreground;
                            font-size: Metrics.text-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        if root.servers.length > 0: AppButton {
                            icon: "close";
                            tooltip: "Close";
                            variant: "ghost";
                            size: "sm";
                            horizontal-stretch: 0;
                            clicked => {
                                root.reset();
                                root.form-open = false;
                            }
                        }
                    }

                    FormField {
                        label: "Name";
                        placeholder: "e.g. prod-jakarta";
                        text <=> root.draft-name;
                        edited => {
                            root.draft-changed();
                        }
                    }

                    HorizontalLayout {
                        spacing: Metrics.s2;

                        FormField {
                            label: "Host";
                            placeholder: "127.0.0.1";
                            mono: true;
                            text <=> root.draft-host;
                            edited => {
                                root.draft-changed();
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 0;
                            width: 84px;

                            FormField {
                                label: "Port";
                                placeholder: "5678";
                                mono: true;
                                text <=> root.draft-port;
                                edited => {
                                    root.draft-changed();
                                }
                            }
                        }
                    }

                    FormField {
                        label: "User";
                        placeholder: "nusadb-root";
                        text <=> root.draft-user;
                        edited => {
                            root.draft-changed();
                        }
                    }

                    FormField {
                        label: "Password";
                        placeholder: "Empty = trust authentication";
                        hint: root.draft-remember
                            ? "Kept in the system keychain, never in Studio's own files."
                            : "Kept for this session only. Turn on Remember to keep it in the system keychain.";
                        password: true;
                        text <=> root.draft-password;
                        edited => {
                            root.draft-changed();
                        }
                    }

                    Toggle {
                        label: "Remember password";
                        checked <=> root.draft-remember;
                        toggled => {
                            root.draft-changed();
                        }
                    }

                    FormField {
                        label: "Database";
                        placeholder: "nusadb";
                        text <=> root.draft-database;
                        edited => {
                            root.draft-changed();
                        }
                    }

                    Text {
                        text: "Environment";
                        color: Theme.muted-fg;
                        font-size: Metrics.text-sm;
                        font-weight: 500;
                    }

                    HorizontalLayout {
                        spacing: Metrics.s2;

                        EnvChip {
                            env: "prod";
                            active: root.draft-env == "prod";
                            picked => {
                                root.draft-env = "prod";
                                root.draft-changed();
                            }
                        }

                        EnvChip {
                            env: "staging";
                            active: root.draft-env == "staging";
                            picked => {
                                root.draft-env = "staging";
                                root.draft-changed();
                            }
                        }

                        EnvChip {
                            env: "dev";
                            active: root.draft-env == "dev";
                            picked => {
                                root.draft-env = "dev";
                                root.draft-changed();
                            }
                        }

                        Rectangle { }
                    }

                    Toggle {
                        label: "Use TLS";
                        checked <=> root.draft-tls;
                        toggled => {
                            root.draft-changed();
                        }
                    }

                    // Only meaningful with TLS on, and required then: the driver verifies the
                    // server against this bundle, and there is no "trust anything" fallback.
                    if root.draft-tls: FormField {
                        label: "CA certificate";
                        placeholder: "/path/to/ca.pem";
                        hint: "PEM bundle the server certificate is checked against.";
                        mono: true;
                        text <=> root.draft-ca-path;
                        edited => {
                            root.draft-changed();
                        }
                    }

                    FormField {
                        label: "Metrics endpoint (optional)";
                        placeholder: "127.0.0.1:9100";
                        hint: "The server's --metrics-listen address, used by Monitor.";
                        mono: true;
                        text <=> root.draft-metrics;
                        edited => {
                            root.draft-changed();
                        }
                    }

                    if root.form-error != "": ResultBanner {
                        state: "error";
                        message: root.form-error;
                    }

                    if root.test-state != "idle": ResultBanner {
                        state: root.test-state;
                        message: root.test-message;
                    }

                    HorizontalLayout {
                        spacing: Metrics.s2;

                        AppButton {
                            label: root.test-state == "testing" ? "Testing…" : "Test";
                            variant: "secondary";
                            horizontal-stretch: 0;
                            min-width: 84px;
                            enabled: root.test-state != "testing";
                            clicked => {
                                root.test();
                            }
                        }

                        AppButton {
                            label: root.editing ? "Save changes" : "Add server";
                            variant: "primary";
                            horizontal-stretch: 1;
                            clicked => {
                                root.save();
                            }
                        }
                    }

                    // With nothing saved the form is the only thing on the screen, so there is
                    // nothing to go back to.
                    if root.servers.length > 0: AppButton {
                        label: "Cancel";
                        variant: "ghost";
                        clicked => {
                            root.reset();
                            root.form-open = false;
                        }
                    }
                }
                }
            }
        }
    }
}
