import { ScrollView } from "std-widgets.slint";
import { Theme, Metrics } from "../theme.slint";
import { TreeRow } from "../models.slint";
import { Icon } from "../components/icon.slint";
import { AppButton } from "../components/app_button.slint";

// One line of the tree. Indentation, the disclosure arrow, the type icon, and the trailing
// badge all live here so every level of the hierarchy lines up by construction.
component TreeItem inherits Rectangle {
    in property <TreeRow> node;
    in property <bool> selected;
    callback activated();
    callback toggled();
    callback opened();
    // Right-click, at this window position.
    callback context(length, length);

    property <color> tint: root.node.kind == "server" ? Theme.ent-server
        : root.node.kind == "database" ? Theme.ent-database
        : root.node.kind == "schema" ? Theme.ent-schema
        : root.node.kind == "table" ? Theme.ent-table
        : root.node.kind == "view" || root.node.kind == "matview" ? Theme.ent-view
        : root.node.kind == "error" ? Theme.destructive
        : Theme.ent-group;

    property <color> status-tone: root.node.status == "connected" ? Theme.success
        : root.node.status == "connecting" ? Theme.warning
        : root.node.status == "error" ? Theme.destructive
        : Theme.gutter-fg;

    // An error row selects its server, whose inspector shows the full message.
    property <bool> interactive: root.node.kind != "hint";

    height: Metrics.tree-row-h;
    opacity: root.node.dimmed ? 0.6 : 1.0;
    background: root.selected ? Theme.primary.with-alpha(0.18)
        : row-touch.has-hover && root.interactive ? Theme.sidebar-accent
        : Colors.transparent;

    // The whole-row target goes first so the disclosure arrow, declared after it, sits on top
    // and gets its own clicks. (Declared the other way round, the row swallowed every click
    // and the arrow could never open a node.)
    row-touch := TouchArea {
        enabled: root.interactive;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.activated();
        }
        double-clicked => {
            root.opened();
        }
    }

    HorizontalLayout {
        padding-left: 4px + root.node.depth * Metrics.tree-indent;
        padding-right: Metrics.s2;
        spacing: 4px;

        // Disclosure arrow. Leaf rows keep the same slot so their labels stay aligned with
        // the labels of expandable siblings.
        Rectangle {
            width: 16px;
            horizontal-stretch: 0;

            if root.node.expandable: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.node.expanded ? "chevron-down" : "chevron-right";
                tint: arrow-touch.has-hover ? Theme.foreground : Theme.muted-fg;
                size: 10px;
            }

            arrow-touch := TouchArea {
                enabled: root.node.expandable;
                mouse-cursor: root.node.expandable ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.toggled();
                }
            }
        }

        if root.node.kind != "hint": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Rectangle {
                width: 13px;
                height: 13px;

                Icon {
                    name: root.node.kind;
                    tint: root.tint;
                    size: 13px;
                }

                // Connection state rides on the server icon as a small dot, rather than as a
                // word-pill on every row.
                if root.node.kind == "server": Rectangle {
                    x: parent.width - 4px;
                    y: parent.height - 5px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    border-width: 1.5px;
                    border-color: Theme.sidebar;
                    background: root.status-tone;
                }
            }
        }

        Text {
            text: root.node.label;
            color: root.node.kind == "error" ? Theme.destructive
                : root.node.kind == "hint" ? Theme.muted-fg
                : root.selected ? Theme.foreground
                : Theme.sidebar-fg;
            font-size: Metrics.text-sm;
            font-weight: root.selected || root.node.kind == "server" ? 500 : 400;
            font-italic: root.node.kind == "hint";
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.node.badge != "": Text {
            text: root.node.badge;
            color: Theme.muted-fg;
            font-size: Metrics.text-xs;
            font-family: Metrics.font-mono;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}

// Left pane: the unified multi-server navigator.
//
// Every server contributes its subtree to one list, which is the point of the pane — the user
// works across servers without switching windows.
export component ObjectTree inherits Rectangle {
    in property <[TreeRow]> rows;
    in property <string> selected-id;
    in-out property <string> filter;
    callback select(string);
    // Arrow keys and Enter while the tree has focus: "up" | "down" | "left" | "right" | "enter".
    callback key(string);
    callback context(string, length, length);
    callback toggle(string);
    callback open(string);
    callback filter-changed(string);
    callback new-server();
    callback refresh();
    callback collapse-all();

    // Dragged from the right edge; double-click the edge to reset.
    in-out property <length> pane-width: Metrics.tree-w;

    min-width: root.pane-width;
    max-width: root.pane-width;
    background: Theme.sidebar;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: edge.has-hover || edge.pressed ? Theme.primary : Theme.border;
    }

    VerticalLayout {
        // ── Toolbar: actions at the right, no title ─────────────────────────
        Rectangle {
            min-height: Metrics.toolbar-h + 4px;
            max-height: Metrics.toolbar-h + 4px;
            vertical-stretch: 0;

            HorizontalLayout {
                padding-left: Metrics.s3;
                padding-right: Metrics.s1;
                spacing: 0px;

                // Takes the slack, so the buttons sit together at the right edge.
                Rectangle {
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    AppButton {
                        icon: "plus";
                        tooltip: "Add a server";
                        variant: "ghost";
                        size: "sm";
                        clicked => {
                            root.new-server();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    AppButton {
                        icon: "refresh";
                        tooltip: "Reload everything that is open";
                        variant: "ghost";
                        size: "sm";
                        clicked => {
                            root.refresh();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    AppButton {
                        icon: "minus";
                        tooltip: "Collapse all";
                        variant: "ghost";
                        size: "sm";
                        clicked => {
                            root.collapse-all();
                        }
                    }
                }
            }
        }

        // ── Search ───────────────────────────────────────────────────────────
        Rectangle {
            min-height: 34px;
            max-height: 34px;
            vertical-stretch: 0;

            Rectangle {
                x: Metrics.s2;
                y: 2px;
                width: parent.width - 2 * Metrics.s2;
                height: 26px;
                clip: true;
                border-radius: Metrics.radius;
                border-width: 1px;
                border-color: search.has-focus ? Theme.primary : Theme.border;
                background: Theme.input-bg;

                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 4px;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;

                        Icon {
                            name: "search";
                            tint: Theme.muted-fg;
                            size: 12px;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        search := TextInput {
                            text <=> root.filter;
                            font-size: Metrics.text-sm;
                            color: Theme.foreground;
                            selection-background-color: Theme.primary.with-alpha(0.35);
                            selection-foreground-color: Theme.foreground;
                            single-line: true;
                            edited => {
                                root.filter-changed(search.text);
                            }
                        }
                    }

                    if root.filter != "": VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;

                        AppButton {
                            icon: "close";
                            tooltip: "Clear the filter";
                            variant: "ghost";
                            size: "sm";
                            height: 20px;
                            clicked => {
                                root.filter = "";
                                root.filter-changed("");
                            }
                        }
                    }
                }

                if root.filter == "": Text {
                    x: 25px;
                    y: (parent.height - self.height) / 2;
                    text: "Filter servers, tables…";
                    color: Theme.gutter-fg;
                    font-size: Metrics.text-sm;
                }
            }
        }

        // ── Tree ─────────────────────────────────────────────────────────────
        // Arrow keys move the selection, Left/Right close/open, Enter opens, once a row has
        // been clicked (which gives the tree the keyboard).
        keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.UpArrow) { root.key("up"); return accept; }
                if (event.text == Key.DownArrow) { root.key("down"); return accept; }
                if (event.text == Key.LeftArrow) { root.key("left"); return accept; }
                if (event.text == Key.RightArrow) { root.key("right"); return accept; }
                if (event.text == Key.Return) { root.key("enter"); return accept; }
                reject
            }

        list := ScrollView {
            viewport-height: root.rows.length * Metrics.tree-row-h + Metrics.s2;

            VerticalLayout {
                width: list.visible-width;
                padding-top: 2px;
                alignment: start;

                for entry[index] in root.rows: TreeItem {
                    node: entry;
                    selected: entry.id == root.selected-id;
                    activated => {
                        keys.focus();
                        root.select(entry.id);
                    }
                    toggled => {
                        root.toggle(entry.id);
                    }
                    opened => {
                        root.open(entry.id);
                    }
                    context(x, y) => {
                        root.context(entry.id, x, y);
                    }
                }
            }
        }

        }

        if root.rows.length == 0: VerticalLayout {
            vertical-stretch: 0;
            padding: Metrics.s4;
            spacing: Metrics.s2;

            Text {
                text: root.filter != "" ? "Nothing matches “" + root.filter + "”." : "No servers yet.";
                color: Theme.muted-fg;
                font-size: Metrics.text-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if root.filter == "": HorizontalLayout {
                alignment: center;

                AppButton {
                    label: "Add a server";
                    icon: "plus";
                    variant: "outline";
                    size: "sm";
                    clicked => {
                        root.new-server();
                    }
                }
            }
        }
    }

    edge := TouchArea {
        x: parent.width - 4px;
        width: 6px;
        height: parent.height;
        mouse-cursor: MouseCursor.col-resize;
        moved => {
            if (self.pressed) {
                root.pane-width = max(180px, min(480px, root.pane-width + self.mouse-x - self.pressed-x));
            }
        }
        double-clicked => {
            root.pane-width = Metrics.tree-w;
        }
    }
}
