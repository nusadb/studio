import { ScrollView } from "std-widgets.slint";
import { Theme, Metrics } from "../theme.slint";
import { Property } from "../models.slint";
import { Icon } from "../components/icon.slint";

// Right pane: properties of whatever is selected in the object tree.
//
// It is a reader, not an editor — changing an object is the Designer screen's job. Keeping it
// read-only is what lets it show *any* node type without growing a mode per type.
export component Inspector inherits Rectangle {
    in property <string> title;
    in property <string> kind;
    in property <[Property]> properties;

    // Pinned width — see the note in `activity_bar.slint`. Without the clamp the centre pane
    // takes the whole row and pushes this one off the window.
    min-width: Metrics.inspector-w;
    max-width: Metrics.inspector-w;
    background: Theme.card;

    // `border-l border-border` on the pane. The `x` is not optional: a child of a non-layout
    // parent with no explicit position is centred, which would float this hairline down the
    // middle of the pane instead of sitting on its left edge.
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        // ── Header ───────────────────────────────────────────────────────────
        Rectangle {
            min-height: Metrics.toolbar-h;
            max-height: Metrics.toolbar-h;
            vertical-stretch: 0;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: Metrics.s3;
                padding-right: Metrics.s3;
                spacing: 6px;

                Text {
                    text: "INSPECTOR";
                    color: Theme.muted-fg;
                    font-size: Metrics.text-xs;
                    font-weight: 600;
                    letter-spacing: 0.6px;
                    vertical-alignment: center;
                }
            }
        }

        // ── Selected object ──────────────────────────────────────────────────
        if root.title != "": Rectangle {
            min-height: 44px;
            max-height: 44px;
            vertical-stretch: 0;

            HorizontalLayout {
                padding-left: Metrics.s3;
                padding-right: Metrics.s3;
                spacing: Metrics.s2;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    Icon {
                        name: root.kind;
                        tint: Theme.primary;
                        size: 15px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.title;
                        color: Theme.foreground;
                        font-size: Metrics.text-md;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: root.kind;
                        color: Theme.muted-fg;
                        font-size: Metrics.text-xs;
                    }
                }
            }
        }

        // ── Properties ───────────────────────────────────────────────────────
        if root.properties.length > 0: props := ScrollView {
            viewport-height: root.properties.length * 34px + Metrics.s2;

            VerticalLayout {
                width: props.visible-width;
                padding-top: Metrics.s1;
                alignment: start;

                for entry[index] in root.properties: Rectangle {
                    height: 34px;

                    HorizontalLayout {
                        padding-left: Metrics.s3;
                        padding-right: Metrics.s3;
                        spacing: Metrics.s2;

                        VerticalLayout {
                            alignment: center;
                            width: 78px;
                            horizontal-stretch: 0;

                            Text {
                                text: entry.label;
                                color: Theme.muted-fg;
                                font-size: Metrics.text-sm;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: entry.value;
                                color: Theme.foreground;
                                font-size: Metrics.text-sm;
                                font-family: entry.mono ? Metrics.font-mono : Metrics.font-ui;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        if root.title == "": VerticalLayout {
            alignment: center;
            padding-left: Metrics.s4;
            padding-right: Metrics.s4;

            Text {
                text: "Select an object in the navigator to inspect it.";
                color: Theme.muted-fg;
                font-size: Metrics.text-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
