import { Theme, Metrics } from "../theme.slint";
import { Icon } from "../components/icon.slint";
import { AppButton } from "../components/app_button.slint";
import { StatusDot } from "../components/status_dot.slint";

// Top chrome: identity, what Studio is pointed at, and the theme switch.
//
// Run and transaction controls live on the editor's own toolbar, next to the text they act
// on; a second copy up here only made it unclear which one to press.
//
// The reference mockup draws macOS traffic lights here; Studio does not, because Slint lets
// the operating system draw the real window decorations.
export component TopBar inherits Rectangle {
    in property <string> connection-label: "Not connected";
    in property <string> connection-status: "disconnected";
    in property <bool> connected: false;
    in property <string> env: "";
    in property <bool> inspector-visible: true;
    // Whether the current screen has a details panel at all.
    in property <bool> inspector-available: true;
    callback open-connections();
    callback toggle-inspector();

    min-height: Metrics.topbar-h;
    max-height: Metrics.topbar-h;
    background: Theme.chrome;
    min-width: 0px;
    clip: true;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: Metrics.s3;
        padding-right: Metrics.s2;
        spacing: Metrics.s2;

        // ── Identity ─────────────────────────────────────────────────────────
        // A wordmark, not an app-icon tile: the window title already carries the name, so
        // this only has to anchor the bar.
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;
            padding-right: Metrics.s3;

            VerticalLayout {
                alignment: center;

                Icon {
                    name: "database";
                    tint: Theme.primary;
                    size: 15px;
                }
            }

            Text {
                text: "NusaDB";
                color: Theme.foreground;
                font-size: Metrics.text-md;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: "Studio";
                color: Theme.muted-fg;
                font-size: Metrics.text-md;
                vertical-alignment: center;
            }
        }

        // ── Active target ────────────────────────────────────────────────────
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            switcher := Rectangle {
                height: 26px;
                border-radius: Metrics.radius;
                background: switcher-touch.has-hover ? Theme.muted : Colors.transparent;

                HorizontalLayout {
                    padding-left: Metrics.s2;
                    padding-right: Metrics.s2;
                    spacing: 7px;

                    VerticalLayout {
                        alignment: center;

                        StatusDot {
                            status: root.connection-status;
                            diameter: 7px;
                        }
                    }

                    Text {
                        text: root.connection-label;
                        color: root.connected ? Theme.foreground : Theme.muted-fg;
                        font-size: Metrics.text-sm;
                        font-family: root.connected ? Metrics.font-mono : Metrics.font-ui;
                        vertical-alignment: center;
                    }

                    // Production gets a word, not just a colour: it is the one environment
                    // where running the wrong script costs something.
                    if root.env == "prod": VerticalLayout {
                        alignment: center;

                        Rectangle {
                            height: 16px;
                            border-radius: Metrics.radius-sm;
                            background: Theme.env-prod.with-alpha(0.16);

                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;

                                Text {
                                    text: "PRODUCTION";
                                    color: Theme.env-prod;
                                    font-size: 10px;
                                    font-weight: 600;
                                    letter-spacing: 0.4px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                switcher-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.open-connections();
                    }
                }
            }
        }

        Rectangle { }

    }
}
