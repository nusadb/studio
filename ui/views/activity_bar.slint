import { Theme, Metrics } from "../theme.slint";
import { Icon } from "../components/icon.slint";
import { Tip } from "../components/tooltip.slint";

// One destination in the rail: an icon, named by its tooltip, with the active screen marked
// on the leading edge.
component RailButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> screen;
    in property <string> active-screen;
    callback picked();

    property <bool> active: root.screen == root.active-screen;

    height: 40px;
    background: touch.has-hover && !root.active ? Theme.muted : Colors.transparent;

    Rectangle {
        x: 0;
        y: 9px;
        width: 2px;
        height: parent.height - 18px;
        background: root.active ? Theme.primary : Colors.transparent;
    }

    HorizontalLayout {
        alignment: center;

        VerticalLayout {
            alignment: center;

            Icon {
                name: root.icon;
                tint: root.active ? Theme.primary : touch.has-hover ? Theme.foreground : Theme.muted-fg;
                size: 16px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        changed has-hover => {
            if (self.has-hover) {
                Tip.request-beside(root.label, root.absolute-position.x + root.width,
                    root.absolute-position.y + root.height / 2);
            } else {
                Tip.dismiss();
            }
        }
        clicked => {
            Tip.dismiss();
            root.picked();
        }
    }
}

// Far-left rail: the app's primary navigation between whole screens.
//
// Only screens that work are listed. Entries for unbuilt screens (ER diagram, monitoring, roles,
// backups) led to placeholder pages, which reads as broken to anyone who is not following the
// build plan; they come back to the rail as they are built.
export component ActivityBar inherits Rectangle {
    in property <string> screen: "workspace";
    callback pick(string);

    min-width: Metrics.rail-w;
    max-width: Metrics.rail-w;
    background: Theme.chrome;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        padding-top: Metrics.s1;
        padding-bottom: Metrics.s1;
        spacing: 0px;

        RailButton {
            icon: "code";
            label: "Query";
            screen: "workspace";
            active-screen: root.screen;
            picked => {
                root.pick("workspace");
            }
        }

        RailButton {
            icon: "table";
            label: "Data";
            screen: "datagrid";
            active-screen: root.screen;
            picked => {
                root.pick("datagrid");
            }
        }

        RailButton {
            icon: "columns";
            label: "Design";
            screen: "designer";
            active-screen: root.screen;
            picked => {
                root.pick("designer");
            }
        }

        RailButton {
            icon: "network";
            label: "Diagram";
            screen: "diagram";
            active-screen: root.screen;
            picked => {
                root.pick("diagram");
            }
        }

        RailButton {
            icon: "chart";
            label: "Monitor";
            screen: "monitor";
            active-screen: root.screen;
            picked => {
                root.pick("monitor");
            }
        }

        RailButton {
            icon: "shield";
            label: "Security";
            screen: "security";
            active-screen: root.screen;
            picked => {
                root.pick("security");
            }
        }

        RailButton {
            icon: "server";
            label: "Servers";
            screen: "connections";
            active-screen: root.screen;
            picked => {
                root.pick("connections");
            }
        }

        // Settings sit at the bottom of the rail, apart from the screens.
        Rectangle {
            vertical-stretch: 1;
        }

        RailButton {
            icon: "settings";
            label: "Settings";
            screen: "settings";
            active-screen: root.screen;
            picked => {
                root.pick("settings");
            }
        }
    }
}
