import { Theme, Metrics } from "../theme.slint";
import { Icon } from "icon.slint";

// The one button in Studio. Named `AppButton` rather than `Button` so it never collides with
// the widget of the same name in `std-widgets.slint`, whose platform styling would fight the
// design tokens.
//
// Variants: "primary" (filled brand) · "danger" (filled destructive) · "secondary" (filled
// muted) · "outline" (bordered) · "ghost" (bare, for toolbar affordances).
// Sizes: "sm" (24px, toolbars) · "md" (30px, forms).
export component AppButton inherits Rectangle {
    in property <string> label;
    in property <string> variant: "primary";
    in property <string> size: "md";
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();

    property <bool> filled: root.variant == "primary" || root.variant == "danger";
    property <bool> compact: root.size == "sm";
    property <color> tone: root.variant == "danger" ? Theme.destructive : Theme.primary;
    property <color> content: !root.enabled ? Theme.muted-fg
        : root.filled ? Theme.on-primary
        : root.variant == "ghost" ? Theme.muted-fg
        : Theme.foreground;

    height: root.compact ? Metrics.control-sm-h : Metrics.control-h;
    vertical-stretch: 0;
    border-radius: Metrics.radius-sm;
    border-width: root.variant == "outline" ? 1px : 0px;
    border-color: Theme.border;
    opacity: root.enabled ? 1.0 : 0.4;

    background: root.filled ? root.tone
        : root.variant == "secondary" ? Theme.muted
        : (touch.pressed && root.enabled) ? Theme.accent
        : (touch.has-hover && root.enabled) ? Theme.muted
        : Colors.transparent;

    animate background { duration: 90ms; }

    HorizontalLayout {
        alignment: center;
        padding-left: root.compact ? Metrics.s2 : Metrics.s3;
        padding-right: root.compact ? Metrics.s2 : Metrics.s3;
        spacing: root.label == "" ? 0px : 6px;

        if root.icon != "": VerticalLayout {
            alignment: center;

            Icon {
                name: root.icon;
                tint: root.content;
                size: root.compact ? 12px : 14px;
            }
        }

        if root.label != "": Text {
            text: root.label;
            color: root.content;
            font-size: root.compact ? Metrics.text-sm : Metrics.text-md;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}
