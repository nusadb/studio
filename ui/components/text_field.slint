import { Theme, Metrics } from "../theme.slint";

// Single-line text input styled from the design tokens.
//
// Built on the primitive `TextInput` rather than the `LineEdit` widget so the field obeys the
// NusaDB palette on every platform instead of inheriting the host style.
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> mono: false;
    in-out property <string> text;
    callback edited();
    callback accepted();

    // Take the keyboard with the text selected, ready to be typed over.
    public function focus-input() {
        input.focus();
        input.select-all();
    }

    height: Metrics.control-h;
    clip: true;
    background: Theme.input-bg;
    border-radius: Metrics.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.primary : Theme.border;

    HorizontalLayout {
        padding-left: Metrics.s2;
        padding-right: Metrics.s2;

        // A long value scrolls inside the field instead of widening the layout around it.
        VerticalLayout {
            alignment: center;
            min-width: 0px;

            input := TextInput {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                text <=> root.text;
                font-size: Metrics.text-md;
                font-family: root.mono ? Metrics.font-mono : Metrics.font-ui;
                color: Theme.foreground;
                selection-background-color: Theme.primary;
                selection-foreground-color: Theme.on-primary;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                edited => {
                    root.edited();
                }
                accepted => {
                    root.accepted();
                }
            }
        }
    }

    // Drawn above the input but event-transparent (no touch area), so clicking the hint still
    // lands the caret in the field.
    if root.text == "": Text {
        x: Metrics.s2;
        y: (parent.height - self.height) / 2;
        // Never wider than the field: a long hint is cut with an ellipsis.
        width: parent.width - 2 * Metrics.s2;
        text: root.placeholder;
        color: Theme.muted-fg;
        font-size: Metrics.text-md;
        font-family: root.mono ? Metrics.font-mono : Metrics.font-ui;
        overflow: elide;
    }
}
