// NusaDB Studio — window shell.
//
// This file only composes: it owns the window chrome and the properties/callbacks the Rust
// controller binds to, and delegates every pixel to a view. Screens live under `views/`,
// reusable pieces under `components/`, and all colours/sizes come from `theme.slint`.
//
//   ┌──────────────────────── TopBar ────────────────────────┐
//   │ rail │ navigator │       screen       │   inspector    │
//   └─────────────────────── StatusBar ──────────────────────┘

// The UI and code faces ship inside the binary, so the editor is monospaced and the layout
// measures the same on every machine — a fallback to a proportional face would misalign the
// editor's colour layer and its input layer.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMonoNL-Regular.ttf";
import "fonts/JetBrainsMonoNL-Medium.ttf";
import "fonts/JetBrainsMonoNL-Italic.ttf";

import { Theme, Metrics } from "theme.slint";
import { Keys } from "keys.slint";
export { Keys }
import { ProfileStore, VectorStore, PivotStore, SelectionStore } from "stores.slint";
export { ProfileStore, VectorStore, PivotStore, SelectionStore }
import {
    ServerRow, TreeRow, Property, SqlLayer, GridColumn, GridCell, GridRow, MessageRow, ResultPart, ChartBar, ChartPoint, ChartTick, ChartSlice, HistoryRow,
    PlanRow, QueryTabRow, CompletionRow, DesignColumn, DesignIndex, InspectorSection,
    SecRole, SecMember, SecGrantRow, SecTable, SecPolicy, MonTile, MonDb, MonXact,
    DetailTab, DetailRow, DetailSection, ErdColumn, ErdBox, NotifyRow, ImportColumn,
    ProfileBar, ProfileCard, CorrCell, CorrRow, VectorColumn
} from "models.slint";
import { ImportDialog } from "views/import_dialog.slint";
import { PromptDialog } from "views/prompt_dialog.slint";
import { SettingsView } from "views/settings.slint";
import { DiagramView } from "views/diagram.slint";
import { MonitorView } from "views/monitor.slint";
import { SecurityView } from "views/security.slint";
import { TopBar } from "views/top_bar.slint";
import { ActivityBar } from "views/activity_bar.slint";
import { ObjectTree } from "views/object_tree.slint";
import { Inspector } from "views/inspector.slint";
import { Workspace } from "views/workspace.slint";
import { DataView } from "views/data_view.slint";
import { Designer } from "views/designer.slint";
import { ConnectionManager } from "views/connection_manager.slint";
import { StatusBar } from "views/status_bar.slint";
import { ConfirmDialog } from "views/confirm_dialog.slint";
import { Tip } from "components/tooltip.slint";

// Re-exported so the generated Rust bindings expose the row structs and the theme switch.
export {
    ServerRow, TreeRow, Property, SqlLayer, GridColumn, GridCell, GridRow, MessageRow, ResultPart, HistoryRow, PlanRow,
    ChartBar, ChartPoint, ChartTick, ChartSlice, ProfileBar, ProfileCard, CorrCell, CorrRow, VectorColumn,
    QueryTabRow, CompletionRow, DesignColumn, DesignIndex, InspectorSection, Theme, Metrics
}

export component AppWindow inherits Window {
    title: "NusaDB Studio";
    icon: @image-url("../packaging/icons/nusadb-studio-256.png");
    default-font-size: Metrics.text-md;
    default-font-family: Metrics.font-ui;
    background: Theme.background;
    // Opens fully visible on a 1366x768 laptop panel — the common floor for a desktop tool.
    preferred-width: 1240px;
    preferred-height: 700px;
    min-width: 960px;
    min-height: 540px;

    // ── Navigation ───────────────────────────────────────────────────────────
    in-out property <string> screen: "workspace";

    // ── Navigator ────────────────────────────────────────────────────────────
    in property <[TreeRow]> tree-rows;
    in property <string> selected-node;
    in-out property <string> tree-filter;

    // ── Inspector ────────────────────────────────────────────────────────────
    in property <string> inspector-title;
    in property <string> inspector-kind;
    in property <string> inspector-subtitle;
    in property <[Property]> inspector-properties;
    in property <[InspectorSection]> inspector-sections;
    in property <string> inspector-definition;
    in property <string> inspector-comment;
    in property <[string]> inspector-notes;
    in property <[string]> inspector-actions;
    in property <[string]> inspector-maintenance;
    // The right-click menu for the selected navigator row: actions, "-", maintenance.
    in property <[string]> context-actions;
    property <bool> menu-open;
    property <length> menu-x;
    property <length> menu-y;

    // ── Query screen ─────────────────────────────────────────────────────────
    in property <[SqlLayer]> sql-layers;
    in property <string> sql-line-numbers;
    in-out property <string> sql-text;
    in property <[GridColumn]> grid-columns;
    in property <length> grid-columns-width;
    in property <[GridRow]> grid-rows;
    in property <[MessageRow]> messages;
    in property <[ResultPart]> result-parts;
    in property <int> result-part;
    callback pick-part(int);
    // Editor / results split on the Query screen, remembered in settings.json.
    in-out property <float> editor-share: 0.42;
    callback split-moved(float);
    in property <[string]> chart-columns;
    in property <string> chart-kind;
    in property <int> chart-x;
    in property <int> chart-y;
    in property <string> chart-agg;
    in property <[ChartBar]> chart-bars;
    in property <[ChartPoint]> chart-points;
    in property <string> chart-line;
    in property <[ChartTick]> chart-x-ticks;
    in property <[ChartTick]> chart-y-ticks;
    in property <string> chart-x-title;
    in property <string> chart-y-title;
    in property <string> chart-note;
    callback chart-opened();
    callback chart-set(string, int, string);
    callback chart-copy-data();
    in property <int> chart-series;
    in property <string> chart-order;
    in property <int> chart-top;
    in property <[ChartSlice]> chart-slices;
    in property <[string]> chart-legend;
    callback chart-export();
    callback chart-copy();
    in property <string> json-text;
    in property <[PlanRow]> plan-rows;
    in property <[HistoryRow]> history;
    in-out property <int> grid-selected-row: -1;
    in-out property <int> grid-selected-col: -1;
    in property <bool> cell-open;
    in property <string> cell-column;
    in property <string> cell-kind;
    in property <string> cell-value;
    in property <bool> cell-null;
    in property <string> target-label;
    in property <bool> has-target;
    in property <bool> running;
    in property <string> txn-state: "idle";
    in property <string> result-summary;
    in property <string> rows-note;
    in property <bool> has-error;
    in-out property <string> result-tab: "results";

    // ── Data screen ──────────────────────────────────────────────────────────
    in property <string> data-object-label;
    in property <string> data-object-kind: "table";
    in property <string> data-target-label;
    in property <[GridColumn]> data-columns;
    in property <length> data-columns-width;
    in property <[GridRow]> data-rows;
    in property <int> data-first-row: 1;
    in property <string> data-range-label;
    in property <bool> data-can-prev;
    in property <bool> data-can-next;
    in property <bool> data-loading;
    in property <string> data-error;
    in-out property <string> data-filter;
    in-out property <int> data-selected-row: -1;
    in-out property <int> data-selected-col: -1;
    in property <bool> data-cell-open;
    in property <string> data-cell-column;
    in property <string> data-cell-kind;
    in property <string> data-cell-value;
    in property <bool> data-cell-null;
    in property <bool> data-editable;
    in property <string> data-read-only-reason;
    in property <int> data-pending;
    in property <bool> data-saving;
    in property <bool> data-cell-new-row;
    in property <bool> data-cell-staged;
    in-out property <string> data-cell-draft;

    // ── Designer screen ──────────────────────────────────────────────────────
    in property <string> design-mode;
    in property <string> design-original;
    in property <string> design-target;
    in-out property <string> design-schema;
    in-out property <string> design-name;
    in property <[DesignColumn]> design-columns;
    in-out property <int> design-selected: -1;
    in property <string> design-ddl;
    in property <string> design-problem;
    in property <bool> design-has-changes;
    in property <bool> design-applying;
    in property <[DesignIndex]> design-indexes;
    in-out property <string> design-tab: "columns";
    callback design-index-field(int, string, string);
    callback design-index-unique(int, bool);
    callback design-add-index();
    callback design-remove-index(int);
    callback design-new();
    callback design-renamed(string, string);
    callback design-field(int, string, string);
    callback design-flag(int, string, bool);
    callback design-add();
    callback design-remove(int);
    callback design-set-type(int, string);
    callback design-apply();

    // Security
    in property <string> sec-state;
    in property <string> sec-error;
    in property <string> sec-target;
    in property <string> sec-notes;
    in property <bool> sec-roles-editable;
    in property <bool> sec-rls-editable;
    in-out property <string> sec-tab: "roles";
    in-out property <string> sec-role-tab: "privileges";
    in property <[SecRole]> sec-roles;
    in property <int> sec-role-selected: -1;
    in property <string> sec-role-name;
    in property <bool> sec-role-pseudo;
    in property <bool> sec-role-new;
    in property <bool> sec-role-dropped;
    in property <[bool]> sec-flags;
    in property <[bool]> sec-flags-changed;
    in property <[SecMember]> sec-member-of;
    in property <[string]> sec-can-join;
    in property <[string]> sec-members;
    in property <[string]> sec-privileges;
    in property <[SecGrantRow]> sec-grants;
    in property <[SecTable]> sec-tables;
    in property <int> sec-table-selected: -1;
    in property <string> sec-table-label;
    in property <bool> sec-policy-allowed;
    in property <string> sec-policy-blocked;
    in property <[SecPolicy]> sec-policies;
    in property <string> sec-ddl;
    in property <string> sec-problem;
    in property <bool> sec-has-changes;
    in property <bool> sec-applying;
    callback sec-refresh();
    callback sec-revert();
    callback sec-apply();
    callback sec-select-role(int);
    callback sec-new-role(string);
    callback sec-drop-role();
    callback sec-flag(int, bool);
    callback sec-join(string);
    callback sec-leave(string);
    callback sec-admin(string, bool);
    callback sec-grant-cycle(int, int);
    callback sec-grant-row(int);
    callback sec-grant-column(int);
    callback sec-select-table(int);
    callback sec-rls(int, bool);
    callback sec-add-policy();
    callback sec-remove-policy(int);
    callback sec-policy-field(int, string, string);
    // The rail moved to another screen.
    callback screen-picked(string);

    // Import
    in property <bool> imp-open;
    in property <string> imp-table;
    in property <string> imp-file;
    in property <string> imp-summary;
    in property <bool> imp-json;
    in property <string> imp-delimiter;
    in property <bool> imp-header;
    in property <bool> imp-empty-null;
    in property <[ImportColumn]> imp-columns;
    in property <[string]> imp-preview-headers;
    in property <[DetailRow]> imp-preview;
    in property <string> imp-defaults;
    in property <string> imp-problem;
    in property <bool> imp-busy;
    in property <int> imp-rows;
    callback data-import();
    callback imp-set-delimiter(string);
    callback imp-set-header(bool);
    callback imp-set-empty-null(bool);
    callback imp-toggle(int, bool);
    callback imp-cancel();
    callback imp-run();

    // LISTEN / NOTIFY
    in property <[NotifyRow]> notify-rows;
    in property <[string]> notify-channels;
    in property <string> notify-status;
    in property <bool> notify-failed;
    callback notify-listen(string);
    callback notify-unlisten(string);
    callback notify-send(string, string);
    callback notify-clear();

    // ER diagram
    in property <string> erd-state;
    in property <string> erd-error;
    in property <string> erd-target;
    in property <string> erd-summary;
    in property <[ErdBox]> erd-boxes;
    in property <string> erd-edges;
    in property <string> erd-hot-edges;
    in property <float> erd-canvas-w: 800;
    in property <float> erd-canvas-h: 600;
    in property <[string]> erd-schemas;
    in property <string> erd-schema;
    in-out property <float> erd-zoom: 1.0;
    in-out property <string> erd-search;
    callback erd-pick-schema(string);
    callback erd-select(int);
    callback erd-open(int);
    callback erd-drag(int, float, float);
    callback erd-relayout();
    callback erd-export();
    callback erd-searched(string);
    callback erd-reload();

    // Monitor
    in property <string> mon-state;
    in property <string> mon-server;
    in property <string> mon-endpoint;
    in property <string> mon-error;
    in property <bool> mon-paused;
    in property <bool> mon-stale;
    in property <string> mon-updated;
    in property <[MonTile]> mon-tiles;
    in property <string> mon-totals;
    in property <[MonDb]> mon-databases;
    in property <string> mon-backup-last;
    in property <string> mon-backup-detail;
    in property <bool> mon-backup-alert;
    in property <[MonXact]> mon-xacts;
    in property <string> mon-xacts-note;
    in property <string> mon-xacts-database;
    callback mon-toggle-pause();
    callback mon-edit-endpoint();
    callback mon-retry();
    callback mon-refresh-xacts();
    callback mon-xact(int, string);
    callback design-reset();

    // ── Connection state (top bar) ───────────────────────────────────────────
    in property <bool> connected: false;
    in property <string> connection-label: "Not connected";
    in property <string> connection-status: "disconnected";
    in property <string> connection-env;

    // ── Status bar ───────────────────────────────────────────────────────────
    in property <string> status-server: "Not connected";
    in property <string> status-database;
    in property <string> status-rows;
    in property <string> status-timing;
    in property <string> version: "0.1.0";

    // ── Servers screen ───────────────────────────────────────────────────────
    in property <[ServerRow]> servers;
    in property <int> selected-id: -1;
    in property <bool> editing: false;
    in property <string> test-state: "idle";
    in property <string> test-message;
    in property <string> form-error;

    in-out property <string> draft-name;
    in-out property <string> draft-host;
    in-out property <string> draft-port;
    in-out property <string> draft-user;
    in-out property <string> draft-password;
    in-out property <string> draft-database;
    in-out property <string> draft-env: "dev";
    in-out property <bool> draft-tls;
    in-out property <string> draft-ca-path;
    in-out property <string> draft-metrics;
    in-out property <bool> server-form-open;
    in-out property <bool> draft-remember;

    // ── Intents raised by the UI ─────────────────────────────────────────────
    callback filter-changed(string);
    callback select-node(string);
    callback toggle-node(string);
    callback open-node(string);
    callback refresh-tree();
    callback collapse-tree();
    callback inspector-action(string);
    callback tree-key(string);
    callback file-open();
    callback file-save();
    callback file-save-as();
    in-out property <bool> find-open;
    in-out property <bool> find-replace;
    in-out property <string> find-text;
    in-out property <string> replace-text;
    in-out property <bool> find-case;
    in property <string> find-status;
    in property <int> select-end: -1;
    in property <int> reveal-line;
    in property <int> reveal-col;
    in property <int> reveal-serial;
    callback find-changed(string, bool);
    callback find-step(bool);
    callback replace-one();
    callback replace-all();
    callback format-sql();

    callback sql-edited(string, int);
    callback sql-caret(int);
    in property <[CompletionRow]> completions;
    in-out property <int> completion-index;
    in property <int> completion-line;
    in property <int> completion-col;
    in property <int> caret-target;
    in property <int> caret-serial;
    callback complete-request(string, int);
    callback complete-accept(int);
    callback complete-cancel();
    callback run-script();
    callback explain-current(int, int);
    callback run-current(int, int);
    callback stop-script();
    callback txn(string);
    in property <[QueryTabRow]> query-tabs;
    callback tab-new();
    callback tab-select(int);
    callback tab-close(int);
    callback grid-sort(int);
    callback grid-cell(int, int);
    callback grid-close-cell();
    callback pick-history(int);
    // Column widths (drag a header edge, double-click to fit) and copying a cell.
    callback grid-column-resized(int, length);
    callback grid-column-fit(int);
    // The theme was switched; Rust remembers it.
    callback theme-changed(bool);
    callback grid-action(string, int, int, int, int);
    callback grid-paste(int, int, string);
    pure callback grid-col-at(length) -> int;
    in property <bool> grid-has-hidden;
    in-out property <int> grid-anchor-row: -1;
    in-out property <int> grid-anchor-col: -1;
    callback data-column-resized(int, length);
    callback data-column-fit(int);
    callback data-grid-action(string, int, int, int, int);
    callback data-paste(int, int, string);
    pure callback data-col-at(length) -> int;
    in property <bool> data-has-hidden;
    in-out property <int> data-anchor-row: -1;
    in-out property <int> data-anchor-col: -1;
    // Editing a Query result read from one table.
    in property <bool> results-editable;
    in property <string> results-read-only;
    in property <int> results-pending;
    in property <bool> results-saving;
    in property <string> results-error;
    in property <bool> results-cell-staged;
    in-out property <string> cell-draft;
    callback grid-cell-commit(int, int, string);
    callback grid-cell-apply(string);
    callback grid-cell-set-null();
    callback grid-cell-revert();
    callback grid-save();
    callback grid-discard();

    callback data-apply-filter(string);
    callback data-prev();
    callback data-next();
    callback data-reload();
    callback data-open-in-query();
    // Object page tabs (Data, Columns, Indexes…, DDL).
    in property <[DetailTab]> data-tabs;
    in-out property <string> data-tab: "data";
    in property <DetailSection> data-section;
    // Navigator id of the object the Data screen's page shows.
    in property <string> data-page-id;
    callback data-pick-tab(string);
    callback data-open-code(string);
    callback data-sort(int);
    callback data-cell(int, int);
    callback data-close-cell();
    callback data-add-row();
    callback data-delete-row(int, int);
    in property <int> data-sample;
    callback data-pick-sample(int);
    callback data-discard();
    callback data-save();
    callback data-cell-apply(string);
    callback data-cell-commit(int, int, string);
    callback data-cell-set-null();
    callback data-cell-default();
    callback data-cell-revert();

    callback edit-server(int);
    callback remove-server(int);
    callback connect-server(int);
    callback disconnect-server(int);
    callback save-server();
    callback test-connection();
    callback reset-form();
    callback draft-changed();
    // ── Clipboard and notices ────────────────────────────────────────────────
    // A short message in the corner: "Exported 500 rows to …". `toast-serial` changes on every
    // new message so a repeat of the same text still restarts the timer.
    in property <string> toast-text;
    in property <bool> toast-error;
    in property <int> toast-serial;
    callback copy-row();
    callback copy-all();
    callback export-result();
    callback data-copy-row();
    callback data-export();

    // Slint has no clipboard call from Rust, so text goes out through a hidden input.
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.clear-selection();
    }

    // ── Name dialog (new database / schema, rename, duplicate) ──────────────
    in property <bool> prompt-open;
    in property <string> prompt-title;
    in property <string> prompt-subtitle;
    in-out property <string> prompt-value;
    in property <string> prompt-check-label;
    in-out property <bool> prompt-checked;
    in property <string> prompt-accept-label;
    in property <string> prompt-error;
    callback prompt-accept();
    callback prompt-cancel();

    // ── Confirmation dialog ──────────────────────────────────────────────────
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-subtitle;
    in property <[string]> confirm-reasons;
    in property <[bool]> confirm-codes;
    in property <bool> confirm-bullets;
    in property <string> confirm-accept-label: "Run anyway";
    callback confirm-accept();
    callback confirm-cancel();

    // Raised on the UI thread once a connection test finishes, carrying (state, message).
    callback probe-finished(string, string);

    property <bool> show-tree: root.screen != "connections" && root.screen != "settings";
    // Settings (Settings screen), loaded and saved by Rust.
    in-out property <int> setting-page-size: 200;
    in-out property <bool> setting-details;
    in-out property <int> setting-result-rows: 1000;
    in-out property <int> setting-history: 100;
    in property <string> about-version;
    in property <string> about-driver;
    in property <string> about-folder;
    callback settings-changed();
    // The details panel is off until asked for (the top-bar button): every action in it is
    // also on the navigator's right-click menu, and an object's full details have their own
    // page, so by default the work gets the whole width.
    in-out property <bool> inspector-visible: false;
    in-out property <length> navigator-width: Metrics.tree-w;
    // When asked for, it appears where it has something to say: on the screens that work on one
    // object (Query, Data, Design) and once something is selected in the navigator. Monitor,
    // Security and Servers are whole-width screens of their own.
    property <bool> show-inspector: root.inspector-visible && root.selected-node != ""
        && (root.screen == "workspace" || root.screen == "datagrid" || root.screen == "designer")
        // The object page already shows everything about its object; never show it twice.
        && !(root.screen == "datagrid" && root.selected-node == root.data-page-id);

    VerticalLayout {
        TopBar {
            connection-label: root.connection-label;
            connection-status: root.connection-status;
            connected: root.connected;
            env: root.connection-env;
            vertical-stretch: 0;
            open-connections => {
                root.screen = "connections";
            }
            inspector-visible: root.inspector-visible;
            inspector-available: root.screen == "workspace" || root.screen == "datagrid" || root.screen == "designer";
            toggle-inspector => {
                root.inspector-visible = !root.inspector-visible;
            }
        }

        HorizontalLayout {
            ActivityBar {
                screen: root.screen;
                horizontal-stretch: 0;
                pick(next) => {
                    root.screen = next;
                    root.screen-picked(next);
                }
            }

            if root.show-tree: ObjectTree {
                rows: root.tree-rows;
                selected-id: root.selected-node;
                filter <=> root.tree-filter;
                pane-width <=> root.navigator-width;
                horizontal-stretch: 0;
                select(id) => {
                    root.select-node(id);
                }
                key(k) => {
                    root.tree-key(k);
                }
                context(id, x, y) => {
                    root.select-node(id);
                    root.menu-x = x;
                    root.menu-y = y;
                    root.menu-open = root.context-actions.length > 0;
                }
                toggle(id) => {
                    root.toggle-node(id);
                }
                open(id) => {
                    root.open-node(id);
                }
                filter-changed(text) => {
                    root.filter-changed(text);
                }
                new-server => {
                    root.screen = "connections";
                    root.reset-form();
                }
                refresh => {
                    root.refresh-tree();
                }
                collapse-all => {
                    root.collapse-tree();
                }
            }

            // Screen host. Every screen lives inside this one element rather than as a row
            // of conditional siblings, so the row always has the same four children.
            VerticalLayout {
                if root.screen == "workspace": Workspace {
                    layers: root.sql-layers;
                    line-numbers: root.sql-line-numbers;
                    sql-text <=> root.sql-text;
                    columns: root.grid-columns;
                    columns-width: root.grid-columns-width;
                    rows: root.grid-rows;
                    messages: root.messages;
                    result-parts: root.result-parts;
                    result-part: root.result-part;
                    editor-share <=> root.editor-share;
                    chart-columns: root.chart-columns;
                    chart-kind: root.chart-kind;
                    chart-x: root.chart-x;
                    chart-y: root.chart-y;
