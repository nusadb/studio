    // ── Context menu ────────────────────────────────────────────────────────
    if root.menu-open: TouchArea {
        // A click anywhere else closes it.
        clicked => {
            root.menu-open = false;
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu-open = false;
            }
        }
    }

    if root.menu-open: menu := Rectangle {
        property <length> item-h: 26px;
        property <length> rows-h: menu-items.preferred-height;
        // The item under the keyboard (↑ ↓, Enter), or under the pointer.
        property <int> hot: -1;

        // One step up or down, over a separator (two never sit together).
        function step(d: int) {
            let n = root.context-actions.length;
            if (n == 0) {
                return;
            }
            // Nothing picked yet: ↓ starts at the first item, ↑ at the last.
            let from = self.hot >= 0 ? self.hot : (d > 0 ? -1 : 0);
            let i = Math.mod(from + d + n, n);
            self.hot = root.context-actions[i] == "-" ? Math.mod(i + d + n, n) : i;
        }

        menu-keys := FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.menu-open = false;
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    menu.step(1);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    menu.step(-1);
                    return accept;
                }
                if (event.text == Key.Return && menu.hot >= 0) {
                    root.menu-open = false;
                    root.inspector-action(root.context-actions[menu.hot]);
                    return accept;
                }
                return reject;
            }
        }
        x: min(root.menu-x, root.width - self.width - 4px);
        y: min(root.menu-y, root.height - self.height - 4px);
        width: 210px;
        height: self.rows-h + 8px;
        border-radius: Metrics.radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.popover;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 3px;

        menu-items := VerticalLayout {
            y: 4px;
            height: self.preferred-height;

            for label[i] in root.context-actions: Rectangle {
                height: label == "-" ? 9px : menu.item-h;

                if label == "-": Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 1px;
                    background: Theme.border;
                }

                if label != "-": Rectangle {
                    x: 4px;
                    width: parent.width - 8px;
                    border-radius: Metrics.radius-sm;
                    // Destructive entries say so in red, the rest in the normal colour.
                    property <bool> danger: label == "Truncate…" || label == "Drop…";
                    background: menu.hot == i
                        ? (self.danger ? Theme.destructive.with-alpha(0.16) : Theme.primary.with-alpha(0.18))
                        : Colors.transparent;

                    Text {
                        x: 10px;
                        text: label;
                        color: parent.danger ? Theme.destructive : Theme.foreground;
                        font-size: Metrics.text-sm;
                        vertical-alignment: center;
                    }

                    item-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                menu.hot = i;
                            }
                        }
                        clicked => {
                            root.menu-open = false;
                            root.inspector-action(label);
                        }
                    }
                }
            }
        }
    }

    if root.imp-open: ImportDialog {
        table: root.imp-table;
        file: root.imp-file;
        summary: root.imp-summary;
        json: root.imp-json;
