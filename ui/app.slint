        accept-label: root.confirm-accept-label;
        accept => {
            root.confirm-accept();
        }
        cancel => {
            root.confirm-cancel();
        }
    }

    clipboard := TextInput {
        x: -10000px;
        y: -10000px;
        width: 1px;
        height: 1px;
        visible: false;
        single-line: false;
    }

    property <bool> toast-shown;

    changed toast-serial => {
        root.toast-shown = root.toast-text != "";
    }

    Timer {
        interval: 3500ms;
        running: root.toast-shown;
        triggered => {
            root.toast-shown = false;
        }
    }

    if root.toast-shown: Rectangle {
        x: root.width - self.width - Metrics.s4;
        // Above the "not saved yet" bar of the grids, so it never covers Discard / Save.
        y: root.height - self.height - Metrics.statusbar-h - 56px;
        width: min(toast-row.preferred-width, 520px);
        height: 36px;
        border-radius: Metrics.radius;
        border-width: 1px;
        border-color: root.toast-error ? Theme.destructive.with-alpha(0.6) : Theme.border;
        background: Theme.popover;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000055;

        toast-row := HorizontalLayout {
            padding-left: Metrics.s3;
            padding-right: Metrics.s3;
            spacing: Metrics.s2;

            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2;
                border-radius: 3.5px;
                background: root.toast-error ? Theme.destructive : Theme.success;
            }

            Text {
                text: root.toast-text;
                color: Theme.foreground;
                font-size: Metrics.text-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        TouchArea {
            clicked => {
                root.toast-shown = false;
            }
        }
    }

    // ── Tooltip overlay ──────────────────────────────────────────────────────
    Timer {
        interval: 450ms;
        running: Tip.armed && !Tip.shown;
        triggered => {
            Tip.shown = true;
        }
    }

    if Tip.shown: tip := Rectangle {
        width: tip-text.preferred-width + 16px;
        height: 24px;
        x: Tip.beside ? Tip.x + 6px : max(4px, min(Tip.x - self.width / 2, root.width - self.width - 4px));
        // Flip above the anchor when there is no room below (status bar buttons).
        y: Tip.beside ? Tip.y - self.height / 2
            : Tip.y + self.height > root.height - 4px ? Tip.y - self.height - 36px : Tip.y;
        border-radius: Metrics.radius-sm;
        background: Theme.dark ? #3A3D44 : #1E2125;

        tip-text := Text {
            text: Tip.text;
            color: #FFFFFF;
            font-size: Metrics.text-xs;
        }
    }
}
