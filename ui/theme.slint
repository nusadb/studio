// Design tokens — the single source of truth for every colour, size, and font in Studio.
//
// Values are ported 1:1 from the visual reference `gui/desain/src/styles/theme.css`
// (`:root` = dark, `.light` = light). A view must NEVER hard-code a colour or a spacing
// number: bind to `Theme.*` / `Metrics.*` instead, so a design iteration is a one-file edit.

export global Theme {
    // The app-wide theme switch. Every colour below derives from it, so flipping this one
    // property re-themes the whole window without touching any view.
    in-out property <bool> dark: true;

    // ── Surfaces ─────────────────────────────────────────────────────────────
    out property <color> background: dark ? #0D0E15 : #F3F4FB;
    out property <color> card: dark ? #12141E : #FFFFFF;
    out property <color> popover: dark ? #1A1C2C : #FFFFFF;
    out property <color> muted: dark ? #181A28 : #EAECF8;
    out property <color> secondary: dark ? #1E2035 : #EAECF8;
    out property <color> accent: dark ? #1A1C30 : #E8E9FF;
    out property <color> input-bg: dark ? #181A28 : #F3F4FB;
    out property <color> switch-bg: dark ? #2A2D48 : #B8BCE0;
    out property <color> sidebar: dark ? #0A0B11 : #EDEEF8;
    out property <color> sidebar-accent: dark ? #181A28 : #E0E2F4;

    // ── Content ──────────────────────────────────────────────────────────────
    out property <color> foreground: dark ? #C2CAE2 : #1A1C30;
    out property <color> muted-fg: dark ? #56607E : #5A6080;
    out property <color> sidebar-fg: dark ? #9BA3C0 : #3A3E60;
    out property <color> accent-fg: dark ? #818CF8 : #4F51D9;
    out property <color> on-primary: #FFFFFF;

    // ── Lines ────────────────────────────────────────────────────────────────
    out property <color> border: dark ? #222540 : #C8CCE4;
    out property <color> sidebar-border: dark ? #1C1E30 : #D0D4EC;

    // ── Brand ────────────────────────────────────────────────────────────────
    out property <color> primary: dark ? #6366F1 : #4F51D9;

    // ── Semantic status colours ──────────────────────────────────────────────
    // The reference sheet has no dedicated success/warning/info tokens, so these reuse the
    // chart ramp with the meaning the design brief assigns: green = healthy/connected,
    // amber = warning/connecting, red = error/down, cyan = info.
    out property <color> destructive: dark ? #EF4444 : #DC2626;
    out property <color> success: dark ? #4ADE80 : #16A34A;
    out property <color> warning: dark ? #FBBF24 : #D97706;
    out property <color> info: dark ? #22D3EE : #0891B2;

    // ── Environment colour tags (Connection Manager) ─────────────────────────
    out property <color> env-prod: dark ? #F87171 : #EF4444;
    out property <color> env-staging: dark ? #FBBF24 : #D97706;
    out property <color> env-dev: dark ? #22D3EE : #0891B2;
}

export global Metrics {
    // 8px spacing grid, per the design brief.
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 24px;
    out property <length> s6: 32px;

    // `--radius: 0.375rem` against the sheet's 13px root font-size ≈ 4.9px; the sm/lg steps
    // follow shadcn's `radius ∓ 2px` / `radius + 4px` arithmetic.
    out property <length> radius-sm: 3px;
    out property <length> radius: 5px;
    out property <length> radius-lg: 9px;

    // Native-dense sizing: compact controls 28–32px, dense list rows 24–28px.
    out property <length> control-h: 30px;
    out property <length> row-h: 26px;

    // Type scale anchored on the sheet's 13px base.
    out property <length> text-xs: 10px;
    out property <length> text-sm: 11px;
    out property <length> text-md: 13px;
    out property <length> text-lg: 15px;
    out property <length> text-xl: 18px;

    // A missing family falls back to the platform default, so an unbundled font degrades
    // gracefully rather than failing to render.
    out property <string> font-ui: "Inter";
    out property <string> font-mono: "JetBrains Mono";
}
