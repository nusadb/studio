// Design tokens — the single source of truth for every colour, size, and font in Studio.
//
// The colours are NusaDB's own, not a component kit's stock palette. A view must NEVER
// hard-code a colour or a spacing number: bind to `Theme.*` / `Metrics.*` instead, so a design
// iteration is a one-file edit.

export global Theme {
    // The app-wide theme switch. Every colour below derives from it, so flipping this one
    // property re-themes the whole window without touching any view.
    in-out property <bool> dark: false;

    // The palette is Studio's own rather than a component-kit default: graphite neutrals with
    // no blue cast (long sessions over a data grid are easier on a neutral ground), one NusaDB
    // indigo accent used sparingly for "this is the action / this is selected", and status hues
    // pulled toward the same lightness so none of them shouts. Secondary text is kept at
    // ≥ 4.5:1 against its surface in both themes — small grey text is most of a dense tool.

    // ── Surfaces ─────────────────────────────────────────────────────────────
    out property <color> background: dark ? #1A1B1E : #FFFFFF;
    out property <color> card: dark ? #1F2023 : #F6F7F8;
    out property <color> popover: dark ? #26282C : #FFFFFF;
    out property <color> muted: dark ? #2A2C31 : #ECEEF0;
    out property <color> secondary: dark ? #2A2C31 : #E9EBEE;
    out property <color> accent: dark ? #33363C : #DFE2E6;
    out property <color> input-bg: dark ? #151618 : #FFFFFF;
    out property <color> switch-bg: dark ? #3A3D44 : #C5C9CF;
    // Window chrome: top bar, activity rail, status bar.
    out property <color> chrome: dark ? #141517 : #EEF0F2;
    out property <color> sidebar: dark ? #18191C : #F4F5F6;
    out property <color> sidebar-accent: dark ? #2A2C31 : #E4E7EA;
    // Alternate grid rows.
    out property <color> zebra: dark ? #1D1E21 : #FAFAFB;

    // ── Content ──────────────────────────────────────────────────────────────
    out property <color> foreground: dark ? #DCDEE3 : #1E2125;
    out property <color> muted-fg: dark ? #8D929C : #5D636B;
    out property <color> sidebar-fg: dark ? #B4B8C0 : #3A3F46;
    out property <color> accent-fg: dark ? #B3BCFF : #27318C;
    out property <color> on-primary: dark ? #0F1433 : #FFFFFF;
    // Line-number gutter in the SQL editor, and NULL in the grid.
    out property <color> gutter-fg: dark ? #5E626B : #A0A5AC;

    // ── Lines ────────────────────────────────────────────────────────────────
    out property <color> border: dark ? #2E3036 : #D7DADF;
    out property <color> sidebar-border: dark ? #26282C : #E1E3E7;

    // ── Brand ────────────────────────────────────────────────────────────────
    // NusaDB navy (#0F1433, the website's theme colour), lifted to an indigo that reads as
    // an action colour: white text on it in light mode, navy text on it in dark mode.
    out property <color> primary: dark ? #8E9BFF : #2E3A9E;
    out property <color> brand-navy: #0F1433;
    // Series colours for charts, kept apart in hue and close in weight (same order as
    // `chart::PALETTE`).
    out property <[color]> series: dark
        ? [#8E9BFF, #F0A94B, #4FC3D9, #F07BB0, #9BCB5A, #B79CFF, #E0A46A, #9AA6B6]
        : [#2E3A9E, #D97706, #0E7490, #BE185D, #4D7C0F, #7C3AED, #B45309, #475569];

    // ── Semantic status colours ──────────────────────────────────────────────
    out property <color> destructive: dark ? #E5675E : #C2413A;
    out property <color> success: dark ? #7BC67B : #2F8A3E;
    out property <color> warning: dark ? #E0B04F : #9A6508;
    out property <color> info: dark ? #6CB4E0 : #1F6FA8;

    // ── Environment colour tags (Connection Manager) ─────────────────────────
    out property <color> env-prod: dark ? #E5675E : #C2413A;
    out property <color> env-staging: dark ? #E0B04F : #9A6508;
    out property <color> env-dev: dark ? #8D929C : #5D636B;

    // ── Object-tree entity colours ───────────────────────────────────────────
    // Muted on purpose: the icon shape already says what a row is, colour only helps the eye
    // group levels. Tables carry the accent because they are what people open most.
    out property <color> ent-server: dark ? #B4B8C0 : #4A5058;
    out property <color> ent-database: dark ? #6CB4E0 : #1F6FA8;
    out property <color> ent-schema: dark ? #C9A86A : #8A6514;
    out property <color> ent-group: dark ? #8D929C : #5D636B;
    out property <color> ent-table: dark ? #8E9BFF : #2E3A9E;
    out property <color> ent-view: dark ? #B48EDC : #7444B0;
    out property <color> ent-index: dark ? #8D929C : #5D636B;
    out property <color> ent-sequence: dark ? #D9895B : #A8521A;
    out property <color> ent-function: dark ? #B48EDC : #7444B0;
    out property <color> ent-policy: dark ? #E5675E : #C2413A;

    // ── SQL syntax colours ───────────────────────────────────────────────────
    out property <color> sql-keyword: dark ? #D9895B : #A8521A;
    out property <color> sql-ident: dark ? #C9CFD6 : #1E2125;
    out property <color> sql-string: dark ? #8FB573 : #4C7A2E;
    out property <color> sql-comment: dark ? #767B84 : #80868E;
    out property <color> sql-number: dark ? #79A9D6 : #1F5FA8;
    out property <color> sql-cast: dark ? #B48EDC : #7444B0;
    out property <color> sql-punct: dark ? #9AA0A8 : #5D636B;
}

export global Metrics {
    // 8px spacing grid, per the design brief.
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 24px;
    out property <length> s6: 32px;

    // The base radius is about 4.9px at a 13px root font size; the small and large steps sit
    // 2px below and 4px above it.
    out property <length> radius-sm: 3px;
    out property <length> radius: 4px;
    out property <length> radius-lg: 6px;

    // ── Chrome geometry, measured from the reference layout ──────────────────
    out property <length> topbar-h: 40px;
    out property <length> rail-w: 40px;
    out property <length> tree-w: 240px;
    out property <length> inspector-w: 260px;
    out property <length> statusbar-h: 24px;
    out property <length> toolbar-h: 32px;

    // Native-dense sizing: compact controls 24–30px, dense rows 19–26px.
    out property <length> control-h: 30px;
    out property <length> control-sm-h: 24px;
    out property <length> tree-row-h: 22px;
    out property <length> grid-row-h: 24px;
    out property <length> row-h: 26px;

    // Type scale anchored on the sheet's 13px base.
    // Nothing below 11px: the smallest size has to stay readable on a 1x laptop panel.
    out property <length> text-xs: 11px;
    out property <length> text-sm: 12px;
    out property <length> text-md: 13px;
    out property <length> text-lg: 15px;
    out property <length> text-xl: 18px;
    // The SQL editor and data cells sit between sm and md in the reference.
    // Settable: Settings → Editor font size.
    in-out property <length> text-code: 13px;

    // Indentation added per level of the object tree.
    out property <length> tree-indent: 13px;

    // A missing family falls back to the platform default, so an unbundled font degrades
    // gracefully rather than failing to render.
    out property <string> font-ui: "Inter";
    // The "NL" cut has no ligatures: in SQL, `>=` must read as two characters, not as ≥.
    out property <string> font-mono: "JetBrains Mono NL";
}
